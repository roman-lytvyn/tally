# The Bela app. Read by devops/apps/use_app.dart and by the packaging
# scripts; sourced by the pipeline, so every value is quoted.

# The game whose rules the app keeps score by.
APP_GAME="bela"
# The Android application id, the Linux application id and the Store identity.
APP_PACKAGE_ID="com.deberc.bela"
# The executable, the Linux package and the names of the built files.
APP_FILE_NAME="bela"
APP_NAME="Bela"
APP_NAME_UK="Бела"
APP_NAME_FR="Bela"
APP_NAME_BG="Бела"
APP_NAME_HR="Bela"
APP_NAME_NL="Bela"
APP_NAME_AR="Bela"
# The title of the desktop window and of the Windows package.
APP_TITLE="Bela"
APP_COMMENT="Keep the score of a game of bela"
APP_COMMENT_UK="Рахунок гри в белу"
APP_KEYWORDS="bela;belot;cards;score;"
APP_KEYWORDS_UK="бела;карти;рахунок;"
APP_SUMMARY="Bela score counter"
APP_DESCRIPTION="Keeps the score of a game of bela for two players or 2 x 2 teams: declarations, bela, štiglja, the fall of the side that called the trump, a belot that wins the game and the deal order, to 501, 701 or 1001."
APP_WEBSITE="https://tallycards.app"
# The Windows installer's own id, which keeps updates installing over it.
APP_WINDOWS_ID="B9224881-ED7D-42CF-94B9-D500C18ED3EE"
# The app has no Microsoft Store listing yet, so its package is self-signed.
APP_MS_STORE="false"
# The app has no Google Play listing yet, so nothing is uploaded there.
APP_GOOGLE_PLAY="false"