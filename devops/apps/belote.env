# The Belote app. Read by devops/apps/use_app.dart and by the packaging
# scripts; sourced by the pipeline, so every value is quoted.

# The game whose rules the app keeps score by.
APP_GAME="belote"
# The Android, iOS and macOS application id, the Linux application id and the
# Store identity.
APP_PACKAGE_ID="app.tallycards.belote"
# The executable, the iOS bundle name, the Linux package and the names of the
# built files.
APP_FILE_NAME="belote"
APP_NAME="Belote"
APP_NAME_UK="Белот"
APP_NAME_FR="Belote"
APP_NAME_BG="Белот"
APP_NAME_HR="Belote"
APP_NAME_NL="Belote"
APP_NAME_AR="Belote"
# The title of the desktop window and of the Windows package.
APP_TITLE="Belote"
APP_COMMENT="Keep the score of a belote game"
APP_COMMENT_UK="Рахунок гри в белот"
APP_KEYWORDS="belote;belot;cards;score;"
APP_KEYWORDS_UK="белот;карти;рахунок;"
APP_SUMMARY="Belote score counter"
APP_DESCRIPTION="Keeps the score of a game of belote for two sides, three players or 2 x 2 teams: points per deal, declarations, belote-rebelote, capot, dedans and the deal order."
APP_WEBSITE="https://tallycards.app"
# The Windows installer's own id, which keeps updates installing over it.
APP_WINDOWS_ID="7B66C75A-F638-4199-8F4E-B6571E0071E6"
# The app's Microsoft Store listing: its Store ID and the package identity
# Partner Center reserved for it. The publisher is the same for every app and
# comes from the MSIX_PUBLISHER CI/CD variable.
APP_MS_STORE="true"
APP_MS_STORE_ID="9PHXSHVHXRWC"
APP_MS_IDENTITY_NAME="RomanLytvyn.BeloteTally"
# The name the Store reserved for the app; the package must carry it.
APP_MS_STORE_NAME="Belote Tally"
# The app has no Google Play listing yet, so nothing is uploaded there.
APP_GOOGLE_PLAY="false"