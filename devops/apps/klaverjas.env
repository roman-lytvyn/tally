# The Klaverjas app. Read by devops/apps/use_app.dart and by the packaging
# scripts; sourced by the pipeline, so every value is quoted.

# The game whose rules the app keeps score by.
APP_GAME="klaverjas"
# The Android application id, the Linux application id and the Store identity.
APP_PACKAGE_ID="com.deberc.klaverjas"
# The executable, the Linux package and the names of the built files.
APP_FILE_NAME="klaverjas"
APP_NAME="Klaverjas"
APP_NAME_UK="Клаверяс"
APP_NAME_FR="Klaverjas"
APP_NAME_BG="Клаверяс"
APP_NAME_HR="Klaverjas"
APP_NAME_NL="Klaverjas"
APP_NAME_AR="Klaverjas"
# The title of the desktop window and of the Windows package.
APP_TITLE="Klaverjas"
APP_COMMENT="Keep the score of a game of klaverjas"
APP_COMMENT_UK="Рахунок гри в клаверяс"
APP_KEYWORDS="klaverjas;klaverjassen;cards;score;"
APP_KEYWORDS_UK="клаверяс;карти;рахунок;"
APP_SUMMARY="Klaverjas score counter"
APP_DESCRIPTION="Keeps the score of a game of klaverjas for 2 x 2 teams by the Amsterdam rules: roem, stuk, pit, nat for the playing side and the deal order, to 1500."
APP_WEBSITE="https://deberc.lytvyn.org"
# The Windows installer's own id, which keeps updates installing over it.
APP_WINDOWS_ID="6F3C2A51-8B47-4E2D-9C1A-7D52B0E4A93F"
# The app has no Microsoft Store listing yet, so its package is self-signed.
APP_MS_STORE="false"
# The app has no Google Play listing yet, so nothing is uploaded there.
APP_GOOGLE_PLAY="false"