# The Deberc app. Read by devops/apps/use_app.dart and by the packaging
# scripts; sourced by the pipeline, so every value is quoted.

# The game whose rules the app keeps score by.
APP_GAME="deberc"
# The Android application id, the Linux application id and the Store identity.
APP_PACKAGE_ID="com.deberc.deberc"
# The executable, the Linux package and the names of the built files.
APP_FILE_NAME="deberc"
APP_NAME="Deberc"
APP_NAME_UK="Деберць"
APP_NAME_FR="Deberc"
APP_NAME_BG="Деберц"
APP_NAME_HR="Deberc"
APP_NAME_NL="Deberc"
APP_NAME_AR="Deberc"
# The title of the desktop window and of the Windows package.
APP_TITLE="Деберць"
APP_COMMENT="Keep the score of a deberc game"
APP_COMMENT_UK="Рахунок гри в деберць"
APP_KEYWORDS="deberc;deberts;belote;cards;score;"
APP_KEYWORDS_UK="деберць;деберц;белот;карти;рахунок;"
APP_SUMMARY="Deberc score counter"
APP_DESCRIPTION="Keeps the score of a game of deberc for two sides, three players or 2 x 2 teams: points per deal, declarations, bait and the deal order."
APP_WEBSITE="https://deberc.lytvyn.org"
# The Windows installer's own id, which keeps updates installing over it.
APP_WINDOWS_ID="83DDDBB1-F39C-47A3-89A0-56E53BD2BE29"
# The Microsoft Store listing that the MSIX_* and MS_STORE_APP_ID CI/CD
# variables describe belongs to this app.
APP_MS_STORE="true"
# The Google Play listing that GOOGLE_PLAY_SERVICE_ACCOUNT uploads to exists
# for this app.
APP_GOOGLE_PLAY="true"
