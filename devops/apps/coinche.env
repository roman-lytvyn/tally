# The Coinche app. Read by devops/apps/use_app.dart and by the packaging
# scripts; sourced by the pipeline, so every value is quoted.

# The game whose rules the app keeps score by.
APP_GAME="coinche"
# The Android application id, the Linux application id and the Store identity.
APP_PACKAGE_ID="com.deberc.coinche"
# The executable, the Linux package and the names of the built files.
APP_FILE_NAME="coinche"
APP_NAME="Coinche"
APP_NAME_UK="Куанш"
APP_NAME_FR="Coinche"
APP_NAME_BG="Коанш"
APP_NAME_HR="Coinche"
APP_NAME_NL="Coinche"
APP_NAME_AR="Coinche"
# The title of the desktop window and of the Windows package.
APP_TITLE="Coinche"
APP_COMMENT="Keep the score of a game of coinche"
APP_COMMENT_UK="Рахунок гри в куанш"
APP_KEYWORDS="coinche;belote;contree;cards;score;"
APP_KEYWORDS_UK="куанш;белот;карти;рахунок;"
APP_SUMMARY="Coinche score counter"
APP_DESCRIPTION="Keeps the score of a game of coinche (belote contree) for 2 x 2 teams: bids from 80 to capot, coinche and surcoinche, announcements and belote, made and failed contracts, to 2000."
APP_WEBSITE="https://tallycards.app"
# The Windows installer's own id, which keeps updates installing over it.
APP_WINDOWS_ID="ECA65D72-EC63-4AB0-A922-EA86FA962575"
# The app has no Microsoft Store listing yet, so its package is self-signed.
APP_MS_STORE="false"
# The app has no Google Play listing yet, so nothing is uploaded there.
APP_GOOGLE_PLAY="false"