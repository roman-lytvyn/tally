# The Baloot app. Read by devops/apps/use_app.dart and by the packaging
# scripts; sourced by the pipeline, so every value is quoted.

# The game whose rules the app keeps score by.
APP_GAME="baloot"
# The Android application id, the Linux application id and the Store identity.
APP_PACKAGE_ID="com.deberc.baloot"
# The executable, the Linux package and the names of the built files.
APP_FILE_NAME="baloot"
APP_NAME="Baloot"
APP_NAME_UK="Балут"
APP_NAME_FR="Baloot"
APP_NAME_BG="Балут"
APP_NAME_HR="Baloot"
APP_NAME_NL="Baloot"
APP_NAME_AR="بلوت"
# The title of the desktop window and of the Windows package.
APP_TITLE="Baloot"
APP_COMMENT="Keep the score of a game of baloot"
APP_COMMENT_UK="Рахунок гри в балут"
APP_KEYWORDS="baloot;belote;sun;hokm;cards;score;"
APP_KEYWORDS_UK="балут;белот;карти;рахунок;"
APP_SUMMARY="Baloot score counter"
APP_DESCRIPTION="Keeps the score of a game of baloot for 2 x 2 teams: Sun and Hokm contracts, double, three, four and gahwa, projects and baloot, kaboot, to 152 in game points."
APP_WEBSITE="https://tallycards.app"
# The Windows installer's own id, which keeps updates installing over it.
APP_WINDOWS_ID="6EBE3D4E-2D71-4635-9E99-F2F5CE6184E4"
# The app has no Microsoft Store listing yet, so its package is self-signed.
APP_MS_STORE="false"
# The app has no Google Play listing yet, so nothing is uploaded there.
APP_GOOGLE_PLAY="false"