# The Bulgarian Belot app. Read by devops/apps/use_app.dart and by the
# packaging scripts; sourced by the pipeline, so every value is quoted.

# The game whose rules the app keeps score by.
APP_GAME="belot"
# The Android application id, the Linux application id and the Store identity.
APP_PACKAGE_ID="com.deberc.belot"
# The executable, the Linux package and the names of the built files.
APP_FILE_NAME="belot"
APP_NAME="Belot"
APP_NAME_UK="Белот"
APP_NAME_FR="Belot"
APP_NAME_BG="Белот"
APP_NAME_HR="Belot"
APP_NAME_NL="Belot"
APP_NAME_AR="Belot"
# The title of the desktop window and of the Windows package.
APP_TITLE="Belot"
APP_COMMENT="Keep the score of a Bulgarian belot game"
APP_COMMENT_UK="Рахунок гри в болгарський белот"
APP_KEYWORDS="belot;bridge-belot;cards;score;"
APP_KEYWORDS_UK="белот;карти;рахунок;"
APP_SUMMARY="Bulgarian Belot score counter"
APP_DESCRIPTION="Keeps the score of a game of Bulgarian belot for 2 x 2 teams: the contract of every deal, contra and re-contra, declarations, belots, valat, hanging points and the deal order, to 151."
APP_WEBSITE="https://deberc.lytvyn.org"
# The Windows installer's own id, which keeps updates installing over it.
APP_WINDOWS_ID="DB5C874A-DE3F-473F-B163-65F2292E734E"
# The app has no Microsoft Store listing yet, so its package is self-signed.
APP_MS_STORE="false"
# The app has no Google Play listing yet, so nothing is uploaded there.
APP_GOOGLE_PLAY="false"
